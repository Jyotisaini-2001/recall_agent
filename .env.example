# SkillForge environment configuration.
# Copy this file to .env and fill in the keys you have.
# SkillForge uses the first available provider in the chain below.

# ==============================================================
# LLM Providers — at least ONE must be configured
# ==============================================================

# --- Minimax (primary for hackathon — paid, high rate limit) ---
# Sign up: https://www.minimax.io/platform
MINIMAX_API_KEY=sk-cp-179IHH7m7Jhiy9zjxruIsWRvtnYW3k6ajeqRU0AOcOPt1eyqSi5t9EBKDt4lY7v0otyK_tXKdgDv7bymfjVBU8pWD9xx0l9P4HSmTkGX04iWbHWVun_eGWs
MINIMAX_MODEL=Minimax-M2.7
# Available: abab6.5-chat (recommended), abab6.5s-chat (faster), abab5.5-chat (cheaper)

# --- Gemini (free fallback) ---
# Sign up: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
# Free tier: 15 RPM, 1500 RPD on flash. Plenty for the hackathon demo.

# --- Anthropic Claude (gold standard, optional) ---
# Use this for distillation specifically — better skill schemas come out of Claude.
# If you're on Claude Pro, you can skip the API and run Claude Code itself as the distiller manually.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Models: claude-opus-4-7 (gold), claude-sonnet-4-6 (workhorse), claude-haiku-4-5 (cheap+fast)

# --- OpenAI (optional — only used for embeddings if you don't want sentence-transformers) ---
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER options: "local" (sentence-transformers, default, free) | "openai"
EMBEDDING_MODEL_LOCAL=all-MiniLM-L6-v2
EMBEDDING_MODEL_OPENAI=text-embedding-3-small


# ==============================================================
# SkillForge behavior tuning
# ==============================================================

# Where to store skill files
SKILLFORGE_SKILLS_DIR=./skills

# Embedding similarity threshold for FAST PATH cache hit
# - Above this: apply skill template directly (no LLM call)
# - Between this and AUTO_APPLY_BELOW: validate with cheap LLM call
# - Below this: full SLOW path
SKILLFORGE_CONFIDENCE_THRESHOLD=0.80

# Below this confidence, ask user before auto-applying
SKILLFORGE_AUTO_APPLY_BELOW=0.95

# Max retries when a fix attempt fails
SKILLFORGE_MAX_FIX_ATTEMPTS=3

# Provider order — first one with valid key wins
# Comma-separated: minimax, gemini, anthropic
SKILLFORGE_PROVIDER_CHAIN=minimax,gemini,anthropic


# ==============================================================
# Demo / dev knobs
# ==============================================================

# When true, log every LLM call's prompt and response to ./logs/
SKILLFORGE_DEBUG=false

# When true, dashboard auto-refreshes every N seconds
SKILLFORGE_DASHBOARD_REFRESH_SEC=2

# Cap total tokens spent in one session (safety net for the demo)
SKILLFORGE_TOKEN_BUDGET=100000
