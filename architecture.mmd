%% ============================================================
%% Diagram 5 — Provider chain with cost gradient
%% ============================================================

graph LR
    Trigger[Need LLM call] --> Q{Cache hit?}
    Q -->|YES| Skip[Skip · use template]
    Q -->|NO| Cheap[Try Minimax<br/>$ — primary]

    Cheap -->|fail / unavailable| Free[Try Gemini<br/>$$ — free tier]
    Free -->|fail / quota| Gold[Try Claude<br/>$$$ — gold standard]

    Cheap -->|success| Done
    Free -->|success| Done
    Gold -->|success| Done

    Done[Apply fix · log tokens]
    Skip --> DoneFast[Apply fix · ~0 tokens]

    classDef good fill:#dcfce7,stroke:#16a34a
    classDef cheap fill:#fef3c7,stroke:#d97706
    classDef premium fill:#fee2e2,stroke:#dc2626

    class Skip,DoneFast good
    class Cheap,Free cheap
    class Gold premium
